# MySQL
MYSQL_DATABASE=group_admin
MYSQL_USER=group_admin
MYSQL_PASSWORD=change_this_mysql_user_password_2026
MYSQL_ROOT_PASSWORD=change_this_mysql_root_password_2026

# Backend
# Must be replaced before startup. Example generator: openssl rand -base64 48
JWT_SECRET=change_this_jwt_secret_before_deploy
JWT_EXPIRATION_MINUTES=120
# The backend container listens on 8080 and writes uploads to /app/uploads.
# Keep these values aligned with docker-compose.yml and Nginx proxy settings.
UPLOAD_DIR=/app/uploads
BACKEND_PORT=8080

# Frontend / Nginx
# Keep the first deployment on loopback until the default superadmin password is replaced.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# Common
TZ=Asia/Shanghai
